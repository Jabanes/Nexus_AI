# ================================
# NEXUS VOICE ENGINE - Configuration
# ================================
# Copy this file to .env and fill in your actual values

# ================================
# LLM PROVIDER
# ================================
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ================================
# VOICE PROVIDERS
# ================================
# Per-tenant voice provider is set in config.yaml.
# These env vars provide defaults / secrets.

# --- ElevenLabs (recommended) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=your_agent_id_here

# --- NVIDIA PersonaPlex (legacy/optional) ---
PERSONAPLEX_WS_URL=ws://localhost:9000/api/chat
FFMPEG_PATH=ffmpeg

# ================================
# CORS
# ================================
# Comma-separated list of allowed origins. Use * for development.
CORS_ALLOWED_ORIGINS=*

# ================================
# LOGGING
# ================================
LOG_LEVEL=INFO
LOG_FORMAT=COLOR
